# CMake/CheckBuildIdentityDirty.cmake
#
# #880 lock for the "-dirty" half of the build identity: runs the configure's own
# rsbs_git_tree_dirty() (CMake/RsbsBuildIdentity.cmake) on a scratch repository
# with known edits and asserts each verdict. It is the dirty bit's independent
# oracle: the VersionShortCommit / VersionIdentity rows take their expected
# "-dirty" from the same configure value that builds the string, so a detection
# that always read 0 (or always 1 on one platform) would keep them green. CI runs
# this row on every platform's redship tier, so the pathspec excludes are checked
# on Linux and macOS as well as Windows.
#
#   cmake -DWORK_DIR=<scratch dir> -P CheckBuildIdentityDirty.cmake
#
# The scratch repository is isolated from the machine's git configuration
# (GIT_CONFIG_GLOBAL points at an empty file, GIT_CONFIG_NOSYSTEM=1), so a
# person's hooks, signing or autocrlf settings cannot change the verdicts.

if(NOT DEFINED WORK_DIR)
    message(FATAL_ERROR "CheckBuildIdentityDirty: -DWORK_DIR=<dir> is required")
endif()
include(${CMAKE_CURRENT_LIST_DIR}/RsbsBuildIdentity.cmake)

find_program(_git git)
if(NOT _git)
    message(FATAL_ERROR "CheckBuildIdentityDirty: git not found on PATH (the configure needs it too)")
endif()

set(_repo "${WORK_DIR}/build-identity-scratch")
file(REMOVE_RECURSE "${_repo}")
file(MAKE_DIRECTORY "${_repo}")
file(WRITE "${WORK_DIR}/build-identity-empty.gitconfig" "")
set(ENV{GIT_CONFIG_GLOBAL} "${WORK_DIR}/build-identity-empty.gitconfig")
set(ENV{GIT_CONFIG_NOSYSTEM} "1")

function(_git_in_repo)
    execute_process(COMMAND "${_git}" ${ARGN} WORKING_DIRECTORY "${_repo}"
                    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _out)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "CheckBuildIdentityDirty: git ${ARGN} failed (${_rc}):\n${_out}")
    endif()
endfunction()

set(_failures 0)
function(_expect _case _want)
    rsbs_git_tree_dirty("${_repo}" _got)
    if(_got STREQUAL "${_want}")
        message(STATUS "CheckBuildIdentityDirty: ${_case}: dirty=${_got} (expected ${_want}) ok")
    else()
        message(SEND_ERROR "CheckBuildIdentityDirty: FAIL ${_case}: dirty=${_got}, expected ${_want}")
        math(EXPR _n "${_failures} + 1")
        set(_failures ${_n} PARENT_SCOPE)
    endif()
endfunction()

# The fixture: the four regenerated files at their real paths, plus one ordinary
# tracked file, committed once.
_git_in_repo(init -q)
_git_in_repo(config user.name "BuildIdentityDirty")
_git_in_repo(config user.email "build-identity@invalid")
# Windows: a deep build directory (a worktree) passes MAX_PATH inside .git/objects.
_git_in_repo(config core.longpaths true)
foreach(_file IN LISTS RSBS_BUILD_IDENTITY_REGENERATED_FILES)
    file(WRITE "${_repo}/${_file}" "generated\n")
endforeach()
file(WRITE "${_repo}/docs/notes.md" "tracked\n")
_git_in_repo(add -A)
_git_in_repo(commit -q -m fixture)

_expect("clean checkout" 0)

foreach(_file IN LISTS RSBS_BUILD_IDENTITY_REGENERATED_FILES)
    file(WRITE "${_repo}/${_file}" "regenerated by a configure\n")
endforeach()
_expect("the four regenerated files changed" 0)

file(WRITE "${_repo}/untracked.txt" "not tracked\n")
_expect("an untracked file added" 0)

file(APPEND "${_repo}/docs/notes.md" "edited\n")
_expect("a tracked file edited, unstaged" 1)

_git_in_repo(add docs/notes.md)
_expect("a tracked file edited, staged" 1)

_git_in_repo(reset -q --hard)
file(REMOVE "${_repo}/untracked.txt")
_expect("after reset --hard" 0)

file(REMOVE "${_repo}/docs/notes.md")
_expect("a tracked file deleted" 1)

_git_in_repo(reset -q --hard)
file(REMOVE_RECURSE "${_repo}")

if(_failures GREATER 0)
    message(FATAL_ERROR "CheckBuildIdentityDirty: ${_failures} case(s) failed")
endif()
message(STATUS "CheckBuildIdentityDirty: PASS, 7 cases")
